# Postgres connection used by ingest, eval and the API.
DATABASE_URL=postgres://rag:rag@localhost:5433/rag

PORT=3000
# Browser origins allowed to call the API (portfolio microfrontend).
CORS_ORIGINS=http://localhost:5180,http://localhost:5182
LOG_LEVEL=info

# --- Embeddings ---------------------------------------------------------
# "local" runs bge-m3 (1024 dims) with @huggingface/transformers on CPU.
# The model is downloaded once into EMBEDDING_CACHE_DIR and then reused offline.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_CACHE_DIR=./.cache/transformers

# --- Rerank (LLM listwise) ---------------------------------------------
# Any OpenAI-compatible endpoint works. Leave RERANK_BASE_URL empty to skip
# the hybrid+rerank configuration (the eval reports it as "skipped").
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_TIMEOUT_MS=120000
RERANK_CANDIDATES=50

# --- Retrieval ----------------------------------------------------------
TOP_K=10
RRF_K=60
# Per-config thresholds live in config/abstention.json, calibrated by
# scripts/calibrate-abstain.ts (docs/adr/0003-abstention.md). This value is only
# a fallback when that file is missing; leave it unset to use the file.
# ABSTAIN_THRESHOLD=
